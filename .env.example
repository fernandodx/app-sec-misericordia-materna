# Administrador Mestre Inicial (Bootstrap)
INITIAL_ADMIN_EMAIL=nando.djx@gmail.com

# Formato base do link de convite oficial
# Enquanto não registrar o domínio próprio (app.misericordiamaterna.org), use o domínio do Firebase Hosting:
# https://<FIREBASE_PROJECT_ID>.web.app/convite
INVITE_BASE_URL=https://misericordia-materna-sec.web.app/convite

# Configurações do Firebase (Opcional caso utilize firebase_options gerado ou via Env)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
